# Thaalam configuration. Copy to `.env` and fill in. `.env` is gitignored.
#
# Security- and runtime-relevant settings are resolved in `thaalam/config.py`.
# The tuning knobs at the bottom are read directly by their own modules.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | production | staging  (THAALAM_ENV and ENV are accepted aliases)
# Anything other than development enforces production-grade secret handling and
# the app refuses to start if the settings below are unsafe.
APP_ENV=development

# ---------------------------------------------------------------------------
# WHOOP OAuth application
# ---------------------------------------------------------------------------
CLIENT_ID=
CLIENT_SECRET=
# Must exactly match a redirect URI registered in the WHOOP Developer Dashboard.
# WHOOP requires an https:// or whoop:// scheme; plain http://localhost is rejected.
REDIRECT_URI=
# Optional endpoint overrides; blank uses WHOOP's production URLs.
AUTHORIZATION_URL=
TOKEN_URL=
REVOKE_URL=

# ---------------------------------------------------------------------------
# WHOOP token encryption at rest
# ---------------------------------------------------------------------------
# 32 bytes, hex or urlsafe-base64. REQUIRED when APP_ENV is not development:
# outside dev the app refuses to mint a key file next to the token ciphertext.
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
WHOOP_TOKEN_KEY=
# Where to keep a dev-only generated key (default: ~/.thaalam/whoop_token.key).
WHOOP_TOKEN_KEY_FILE=
# Force the production key requirement without changing APP_ENV.
WHOOP_REQUIRE_TOKEN_KEY=
# One-shot escape hatch to migrate a legacy plaintext token file.
WHOOP_MIGRATE_PLAINTEXT_TOKEN=

# ---------------------------------------------------------------------------
# Web surface
# ---------------------------------------------------------------------------
# Comma-separated CORS origins. Leave blank in production: the packaged app
# serves the frontend from the same origin, so no cross-origin allowance is
# needed. A literal "*" is rejected in production.
ALLOWED_ORIGINS=
# Where the OAuth callback sends the browser once WHOOP redirects back.
# Optional in production: left blank, the callback uses the origin the request
# arrived on, which is the domain the app is already being served from. Set it
# only when the frontend lives somewhere else. Never leave a localhost value
# here in a deployment -- it would redirect users to their own machine.
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Sessions and login policy
# ---------------------------------------------------------------------------
# Blank follows APP_ENV (secure in production, off in dev). Setting it to false
# in production is refused -- session cookies would travel over plain HTTP.
COOKIE_SECURE=
SESSION_TTL_MINUTES=720
LOGIN_MAX_ATTEMPTS=5
# Auth database. Deliberately separate from the DuckDB file, which allows only
# one writer -- sharing it would let a 90-day backfill block logins.
AUTH_DB_PATH=

# ---------------------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------------------
# Per-client-address request cap. Counted in this process, which is correct
# only because the app runs a single worker. Set to 0 to disable.
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=1048576
# Comma-separated Host allow-list, e.g. thaalam.example.com. Blank accepts any
# Host header, which is fine when a reverse proxy already routes by host.
ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Sync windows (thaalam/sync.py)
# ---------------------------------------------------------------------------
WHOOP_BACKFILL_DAYS=90
WHOOP_RECONCILE_DAYS=7
MIN_SYNC_INTERVAL_MINUTES=15

# ---------------------------------------------------------------------------
# Scoring and insight thresholds
# ---------------------------------------------------------------------------
# Step source for the Daily movement score component (thaalam/services/derived_metrics.py):
# none | healthkit
STEPS_SOURCE=none
# Rule cutoffs for the daily brief (thaalam/insights_thresholds.py).
ACWR_HIGH_RISK=1.5
ACWR_ELEVATED=1.3
ACWR_LOW_BOUND=0.8
HRV_SUPPRESSION_PCT=-10.0
RHR_ELEVATION_BPM=3.0
SLEEP_DEBT_ALERT_HOURS=1.5
NOTABLE_ZONE_STREAK_DAYS=3
RESPIRATORY_RATE_ELEVATION=1.0
SKIN_TEMP_ELEVATION_C=0.3

# ---------------------------------------------------------------------------
# Nightly recompute
# ---------------------------------------------------------------------------
# Recomputes baselines, bands, regressions and the 30-day score series.
# Runs inside the API process; disable it to drive
# `python -m thaalam.services.nightly_job` from cron instead.
NIGHTLY_JOB_ENABLED=true
NIGHTLY_JOB_HOUR=4

# ---------------------------------------------------------------------------
# Serving (production)
# ---------------------------------------------------------------------------
# Bind address. Defaults to 127.0.0.1 in development, 0.0.0.0 in production.
HOST=
PORT=8001
# Which proxy addresses may set X-Forwarded-For. "*" is right when only your
# reverse proxy can reach the app's port.
FORWARDED_ALLOW_IPS=

# ---------------------------------------------------------------------------
# Persistent data location
# ---------------------------------------------------------------------------
# Holds whoop.duckdb, the encrypted WHOOP token, thaalam_auth.db and the logs.
# Blank resolves next to the source checkout, which is right for local dev.
# A container MUST set this to its mounted volume: an installed package would
# otherwise write into site-packages, and a redeploy would discard everything.
# The app refuses to start in production if it resolves inside the package.
DATA_DIR=

# ---------------------------------------------------------------------------
# Optional: the in-dashboard assistant (OpenRouter)
# ---------------------------------------------------------------------------
# Powers the chat dock on every page. Left unset the assistant is simply off:
# /api/chat/status reports enabled=false and the dashboard hides the dock, so
# nothing breaks -- the rule-based daily brief and every chart are unaffected
# and stay entirely local with no outbound network call.
#
# Get a key at https://openrouter.ai/keys. Free models cost nothing, but the
# free tier is rationed: 20 requests/minute, and 50/day until the account has
# bought $10 of credits at some point (then 1,000/day). That allowance belongs
# to the key and is shared by everyone using this deployment, which is what
# CHAT_REQUESTS_PER_HOUR below rations per account.
#
# In `.env` files quotes are stripped (CLIENT_ID='abc' works), but in the
# Dokploy Environment UI set BARE values with no quotes: CLIENT_ID=abc
OPENROUTER_API_KEY=

# Accepted as a fallback because this misspelling is what earlier versions of
# this file shipped. OPENROUTER_API_KEY wins if both are set.
OPROUTER_API_KEY=

# Pin one model slug (e.g. deepseek/deepseek-chat-v3-0324:free) to force it.
# Blank is recommended: the app asks OpenRouter which models are free right
# now and picks the best, because the free roster is rotated by its providers
# and a slug hardcoded today is a 404 in a month.
OPENROUTER_MODEL=

# Sent to OpenRouter as HTTP-Referer/X-Title, which is how it attributes
# traffic to an app. Blank falls back to FRONTEND_URL. Cosmetic.
OPENROUTER_APP_URL=

# Set false to disable the assistant while leaving the key in place.
CHAT_ENABLED=true

# Per-account hourly cap, so one user cannot spend the whole key's daily
# free-tier allowance in a minute.
CHAT_REQUESTS_PER_HOUR=30

# Ceiling on one answer's length. Answers are meant to be a few sentences.
CHAT_MAX_TOKENS=800
