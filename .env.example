# Thaalam configuration. Copy to `.env` and fill in. `.env` is gitignored.
#
# Security- and runtime-relevant settings are resolved in `thaalam/config.py`.
# The tuning knobs at the bottom are read directly by their own modules.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | production | staging  (THAALAM_ENV and ENV are accepted aliases)
# Anything other than development enforces production-grade secret handling and
# the app refuses to start if the settings below are unsafe.
APP_ENV=development

# ---------------------------------------------------------------------------
# WHOOP OAuth application
# ---------------------------------------------------------------------------
CLIENT_ID=
CLIENT_SECRET=
# Must exactly match a redirect URI registered in the WHOOP Developer Dashboard.
# WHOOP requires an https:// or whoop:// scheme; plain http://localhost is rejected.
REDIRECT_URI=
# Optional endpoint overrides; blank uses WHOOP's production URLs.
AUTHORIZATION_URL=
TOKEN_URL=
REVOKE_URL=

# ---------------------------------------------------------------------------
# WHOOP token encryption at rest
# ---------------------------------------------------------------------------
# 32 bytes, hex or urlsafe-base64. REQUIRED when APP_ENV is not development:
# outside dev the app refuses to mint a key file next to the token ciphertext.
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
WHOOP_TOKEN_KEY=
# Where to keep a dev-only generated key (default: ~/.thaalam/whoop_token.key).
WHOOP_TOKEN_KEY_FILE=
# Force the production key requirement without changing APP_ENV.
WHOOP_REQUIRE_TOKEN_KEY=
# One-shot escape hatch to migrate a legacy plaintext token file.
WHOOP_MIGRATE_PLAINTEXT_TOKEN=

# ---------------------------------------------------------------------------
# Web surface
# ---------------------------------------------------------------------------
# Comma-separated CORS origins. Leave blank in production: the packaged app
# serves the frontend from the same origin, so no cross-origin allowance is
# needed. A literal "*" is rejected in production.
ALLOWED_ORIGINS=
# Where the OAuth callback sends the browser once WHOOP redirects back.
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Sessions and login policy
# ---------------------------------------------------------------------------
# Blank follows APP_ENV (secure in production, off in dev). Setting it to false
# in production is refused -- session cookies would travel over plain HTTP.
COOKIE_SECURE=
SESSION_TTL_MINUTES=720
LOGIN_MAX_ATTEMPTS=5
# Auth database. Deliberately separate from the DuckDB file, which allows only
# one writer -- sharing it would let a 90-day backfill block logins.
AUTH_DB_PATH=

# ---------------------------------------------------------------------------
# Sync windows (thaalam/sync.py)
# ---------------------------------------------------------------------------
WHOOP_BACKFILL_DAYS=90
WHOOP_RECONCILE_DAYS=7
MIN_SYNC_INTERVAL_MINUTES=15

# ---------------------------------------------------------------------------
# Scoring and insight thresholds
# ---------------------------------------------------------------------------
# Step source for the Daily movement score component (thaalam/services/derived_metrics.py):
# none | healthkit
STEPS_SOURCE=none
# Rule cutoffs for the daily brief (thaalam/insights_thresholds.py).
ACWR_HIGH_RISK=1.5
ACWR_ELEVATED=1.3
ACWR_LOW_BOUND=0.8
HRV_SUPPRESSION_PCT=-10.0
RHR_ELEVATION_BPM=3.0
SLEEP_DEBT_ALERT_HOURS=1.5
NOTABLE_ZONE_STREAK_DAYS=3
RESPIRATORY_RATE_ELEVATION=1.0
SKIN_TEMP_ELEVATION_C=0.3
