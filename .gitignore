# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

# Local WHOOP data (DuckDB database + cached OAuth token)
data/

# Working notes stay local. DEPLOYMENT.md is the exception: the README points
# at it, so it has to exist in a fresh clone. A negation cannot re-include a
# file under an excluded directory, hence docs/* rather than docs/.
docs/*
!docs/DEPLOYMENT.md

# Frontend
frontend/node_modules/
frontend/dist/

*/tests_*